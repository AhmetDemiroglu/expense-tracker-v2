    <resources>
        <image name="SplashScreenLogo" width="220" height="220"/>
        <namedColor name="SplashScreenBackground">
            <color red="0.965" green="0.961" blue="0.945" alpha="1.000" colorSpace="custom" customColorSpace="sRGB"/>
